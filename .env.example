# Required server environment variables.
# Keep this file free of real secrets.

# NextAuth
# Generate with: npx auth secret
AUTH_SECRET=""

# Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/one-hat"
# Used by Prisma Migrate when direct DB connection is needed.
DIRECT_URL="postgresql://postgres:password@localhost:5432/one-hat"

# Local app URLs
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Gemini (Google AI Studio)
# Create API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Optional: defaults to gemini-2.0-flash
GEMINI_MODEL="gemini-2.0-flash"

# ImageKit
IMAGEKIT_PRIVATE_KEY=""
NEXT_PUBLIC_IMAGEKIT_KEY=""

# HeyGen
HEYGEN_API_KEY=""
HEYGEN_URL="https://api.heygen.com"
HEYGEN_AVATAR_WEBHOOK_ID=""
